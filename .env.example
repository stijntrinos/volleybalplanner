APP_NAME=Volleybalplanner
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://volleybalplanner-clean.test

APP_LOCALE=nl
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=volleybalplanner
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PLANNER_QUEUE_MODE=shared

# Public site (config/site.php). Empty values are left out of the pages.
SITE_COMPANY=
SITE_EMAIL=
SITE_PHONE=
SITE_CONTACT_RECIPIENT=
SITE_REPLY_DAYS=2
SITE_TRIAL_WEEKS=
SITE_HOSTING=
# Leave empty to use the site's own /privacy and /voorwaarden pages.
SITE_PRIVACY_URL=
SITE_TERMS_URL=

# Platform admins must use a passkey or 2FA (set false only for local development).
AUTH_REQUIRE_PLATFORM_ADMIN_MFA=true

# Production checklist:
#   APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=warning
#   SESSION_SECURE_COOKIE=true, SESSION_ENCRYPT=true
#   MAIL_MAILER=smtp (with MAIL_HOST etc.) and MAIL_FROM_ADDRESS
#   TRUSTED_PROXIES=<load balancer IP(s)> or * behind a proxy you control
#   A queue worker (php artisan queue:work) for mail and per-club jobs,
#   and the scheduler (php artisan schedule:run every minute).
TRUSTED_PROXIES=
